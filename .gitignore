# --- Project artifacts -------------------------------------------------
# Every intermediate/derived file is reproducible from the pipeline,
# so nothing under data/ or outputs/ is versioned except the folder markers.
data/raw/*
data/interim/*
data/processed/*
data/mock/*
outputs/figures/*
outputs/reports/*
!**/.gitkeep
